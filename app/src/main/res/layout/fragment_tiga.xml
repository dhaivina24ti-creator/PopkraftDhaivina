                    android:textSize="12sp"
                    android:fontFamily="@font/poppins_semibold"
                    android:textColor="@color/dark_purple"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="14 November 2026"
                    android:textSize="10sp"
                    android:fontFamily="@font/inter_regular"
                    android:textColor="@color/gray_text"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Galeri Seni"
                    android:textSize="10sp"
                    android:fontFamily="@font/inter_regular"
                    android:textColor="@color/gray_text"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Rp75.000 / orang"
                    android:textSize="12sp"
                    android:fontFamily="@font/poppins_semibold"
                    android:textColor="@color/purple"/>

                <Button
                    android:id="@+id/btnEvent4"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:text="Lihat Detail"
                    android:textAllCaps="false"
                    android:textSize="11sp"
                    android:textColor="@color/white"
                    android:fontFamily="@font/poppins_semibold"
                    android:backgroundTint="@color/purple"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Event 5: Kelas Membatik -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="140dp"
            android:layout_marginTop="10dp"
            android:padding="10dp"
            android:orientation="horizontal"
            android:background="@drawable/bg_card">

            <ImageView
                android:layout_width="105dp"
                android:layout_height="115dp"
                android:src="@drawable/membatik"
                android:scaleType="centerCrop"
                android:contentDescription="Kelas Membatik"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Kelas Membatik"
                    android:textSize="12sp"
                    android:fontFamily="@font/poppins_semibold"
                    android:textColor="@color/dark_purple"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="21 November 2026"
                    android:textSize="10sp"
                    android:fontFamily="@font/inter_regular"
                    android:textColor="@color/gray_text"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Rumah Kreatif"
                    android:textSize="10sp"
                    android:fontFamily="@font/inter_regular"
                    android:textColor="@color/gray_text"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Rp60.000 / orang"
                    android:textSize="12sp"
                    android:fontFamily="@font/poppins_semibold"
                    android:textColor="@color/purple"/>

                <Button
                    android:id="@+id/btnEvent5"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:text="Lihat Detail"
                    android:textAllCaps="false"
                    android:textSize="11sp"
                    android:textColor="@color/white"
                    android:fontFamily="@font/poppins_semibold"
                    android:backgroundTint="@color/purple"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Event 6: Kelas Fotografi -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="140dp"
            android:layout_marginTop="10dp"
            android:padding="10dp"
            android:orientation="horizontal"
            android:background="@drawable/bg_card">

            <ImageView
                android:layout_width="105dp"
                android:layout_height="115dp"
                android:src="@drawable/fotografi"
                android:scaleType="centerCrop"
                android:contentDescription="Kelas Fotografi"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Kelas Fotografi"
                    android:textSize="12sp"
                    android:fontFamily="@font/poppins_semibold"
                    android:textColor="@color/dark_purple"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="28 November 2026"
                    android:textSize="10sp"
                    android:fontFamily="@font/inter_regular"
                    android:textColor="@color/gray_text"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Creative Space"
                    android:textSize="10sp"
                    android:fontFamily="@font/inter_regular"
                    android:textColor="@color/gray_text"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Rp90.000 / orang"
                    android:textSize="12sp"
                    android:fontFamily="@font/poppins_semibold"
                    android:textColor="@color/purple"/>

                <Button
                    android:id="@+id/btnEvent6"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:text="Lihat Detail"
                    android:textAllCaps="false"
                    android:textSize="11sp"
                    android:textColor="@color/white"
                    android:fontFamily="@font/poppins_semibold"
                    android:backgroundTint="@color/purple"/>
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
