            android:layout_height="wrap_content"
            android:text="Pilihan Musik"
            android:textSize="16sp"
            android:textColor="@color/dark_purple"
            android:fontFamily="@font/poppins_semibold"/>

        <!-- Event 1: Mini Concert Labuai -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="140dp"
            android:layout_marginTop="12dp"
            android:padding="10dp"
            android:orientation="horizontal"
            android:background="@drawable/bg_card">

            <ImageView
                android:layout_width="105dp"
                android:layout_height="115dp"
                android:src="@drawable/miniconcert"
                android:scaleType="centerCrop"
                android:contentDescription="Mini Concert Labuai"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Mini Concert Labuai"
                    android:textSize="12sp"
                    android:textColor="@color/dark_purple"
                    android:fontFamily="@font/poppins_semibold"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="20 Oktober 2026"
                    android:textSize="10sp"
                    android:textColor="@color/gray_text"
                    android:fontFamily="@font/inter_regular"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Pekanbaru"
                    android:textSize="10sp"
                    android:textColor="@color/gray_text"
                    android:fontFamily="@font/inter_regular"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Rp45.000 / orang"
                    android:textSize="12sp"
                    android:textColor="@color/purple"
                    android:fontFamily="@font/poppins_semibold"/>

                <Button
                    android:id="@+id/btnEvent1"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:text="Lihat Detail"
                    android:textAllCaps="false"
                    android:textSize="11sp"
                    android:textColor="@color/white"
                    android:backgroundTint="@color/purple"
                    android:fontFamily="@font/poppins_semibold"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Event 2: Sore Akustik Lokal -->
